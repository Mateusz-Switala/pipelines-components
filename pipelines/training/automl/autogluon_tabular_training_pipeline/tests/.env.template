# Copy to .env and fill in your values. Used by integration tests (conftest.py).
# See README_integration.md for full descriptions.

# RHOAI pipeline API
RHOAI_URL=
RHOAI_KFP_URL=
# Service account token (e.g. from Jenkins credentials). Create with: oc create token <sa-name> -n <project>
RHOAI_TOKEN=
RHOAI_PROJECT_NAME=kfp-integration-test

# S3-compatible storage (e.g. MinIO or AWS S3)
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
RHOAI_TEST_DATA_BUCKET=
RHOAI_TEST_ARTIFACTS_BUCKET=
RHOAI_TEST_S3_SECRET_NAME=s3-connection

# ---------------------------------------------------------------------------
# Functional test options
# ---------------------------------------------------------------------------
# Path to the JSON file with test scenario configs (default: functional_test_configs.json in this dir)
# AUTOML_FUNCTIONAL_TEST_CONFIG=functional_test_configs_short.json

# Path to the merged JSON report output (default: functional_test_report.json in this dir)
# AUTOML_FUNCTIONAL_TEST_REPORT=functional_test_report.json

# Set to true/1 to skip S3 artifact cleanup after the test session (useful for debugging).
# AUTOML_FUNCTIONAL_TEST_KEEP_ARTIFACTS=false

# Optional: timeout in seconds for pipeline run (default 3600)
# RHOAI_PIPELINE_RUN_TIMEOUT=3600

# ---------------------------------------------------------------------------
# Post-pipeline KServe deployment (optional)
# ---------------------------------------------------------------------------
# Set to true/1 to deploy the top-1 trained model via KServe after each pipeline run.
# Requires: RHOAI_SERVING_IMAGE or a pre-existing ServingRuntime named RHOAI_SERVING_RUNTIME_NAME.
# RHOAI_DEPLOY_AFTER_TRAINING=false

# Container image for the AutoGluon ServingRuntime.
# Build via: https://github.com/red-hat-data-services/kserve-autogluon-server
# Example: quay.io/opendatahub/odh-kserve-autogluon-server@sha256:<digest>
# RHOAI_SERVING_IMAGE=

# Set to true/1 to auto-create the ServingRuntime if it does not exist (requires RHOAI_SERVING_IMAGE)
# RHOAI_CREATE_SERVING_RUNTIME=false

# Name of an existing ServingRuntime to use instead of creating a per-run one.
# When set, RHOAI_CREATE_SERVING_RUNTIME is ignored and the runtime is never deleted.
# Example: kserve-autogluonserver
# RHOAI_SERVING_RUNTIME_NAME=

# Name of an existing RHOAI Data Connection (secret) to use as the KServe storage key.
# RECOMMENDED: create a Data Connection via the RHOAI Dashboard pointing to the same
# S3 bucket as RHOAI_TEST_ARTIFACTS_BUCKET, then set this to its name.
# When set, no temporary secret is created/deleted and the controller processes it reliably.
# When unset, a temporary secret is created per run — but this may fail if odh-model-controller
# rejects programmatically created secrets (SSA field conflicts or informer lag).
# Example: autogluon-artifacts
# RHOAI_KSERVE_STORAGE_KEY=

# Hardware profile name for the InferenceService (default: default-profile).
# Required by odh-model-controller to create the predictor Deployment.
# RHOAI_HARDWARE_PROFILE_NAME=default-profile

# Namespace where the hardware profile is defined (default: redhat-ods-applications).
# RHOAI_HARDWARE_PROFILE_NAMESPACE=redhat-ods-applications

# Hardware profile Kubernetes resourceVersion — fetched automatically from the cluster
# when unset (with retries). Override only when auto-fetch fails (e.g. missing RBAC for HardwareProfile CRD).
# Get the value from: oc get hardwareprofile default-profile -n redhat-ods-applications -o jsonpath='{.metadata.resourceVersion}'
# RHOAI_HARDWARE_PROFILE_RESOURCE_VERSION=

# Seconds to wait for InferenceService to become ready (default: 300)
# RHOAI_INFERENCE_TIMEOUT=300

# Name of the ConfigMap containing the CA bundle for the KServe storage initializer.
# Required when the S3 endpoint uses a custom/self-signed TLS certificate (e.g. MinIO on OpenShift).
# RHOAI_KSERVE_CA_BUNDLE_CONFIGMAP=odh-kserve-custom-ca-bundle

# ---------------------------------------------------------------------------
# DataSciencePipelinesApplication (DSPA) auto-creation (optional)
# ---------------------------------------------------------------------------
# Optional: create DataSciencePipelinesApplication CR in the test namespace via Kubernetes SDK
# Set to true/1 to create a DSPA CR; requires Data Science Pipelines Operator (DSPO) / Open Data Hub.
# When set, the KFP client URL is resolved from the OpenShift Route created by the operator.
# RHOAI_CREATE_DSPA=false
# Optional: override DSPA CRD identity (defaults: opendatahub.io v1alpha1)
# RHOAI_DSPA_API_GROUP=datasciencepipelinesapplications.opendatahub.io
# RHOAI_DSPA_API_VERSION=v1alpha1
# RHOAI_DSPA_PLURAL=datasciencepipelinesapplications
# Optional: route name prefix to find the pipeline API route (default: ds-pipeline)
# RHOAI_DSPA_ROUTE_NAME_PREFIX=ds-pipeline
# Optional: seconds to wait for the route to appear after creating DSPA (default: 300)
# RHOAI_DSPA_ROUTE_WAIT_TIMEOUT=300
# Optional: seconds to wait for DSPA status to become Ready (default: 600)
# RHOAI_DSPA_READY_WAIT_TIMEOUT=600
# Optional: extra seconds to wait after DSPA is Ready before using the API (default: 30)
# RHOAI_DSPA_READY_BUFFER_SECONDS=30
